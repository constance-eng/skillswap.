    setError(null);
    try {
      const data = await apiRequest("/transactions/me", { token: idToken });
      setTransactions(data.transactions);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
