<file path="backend/src/handlers/putSession.js">
const { DynamoDBClient } = require("@aws-sdk/client-dynamodb");
const {
  DynamoDBDocumentClient,
  GetCommand,
  PutCommand,
} = require("@aws-sdk/lib-dynamodb");
const { validate, sanitize } = require("../lib/validate");
const { checkRateLimit } = require("../lib/rateLimit");

const client = DynamoDBDocumentClient.from(new DynamoDBClient({}));
const TRANSACTIONS_TABLE = process.env.TRANSACTIONS_TABLE;
const SESSIONS_TABLE = process.env.SESSIONS_TABLE;

const response = (statusCode, body) => ({
  statusCode,
  headers: {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": process.env.ALLOWED_ORIGIN || "*",
  },
  body: JSON.stringify(body),
});

const URL_PATTERN = /^https?:\/\/.+/;

const schema = {
  format: { type: "string", required: true, minLength: 1, maxLength: 20 },
  sessionLink: { type: "string", maxLength: 500, pattern: URL_PATTERN },
  location: { type: "string", maxLength: 200 },
  suggestedDateTime: { type: "string", maxLength: 40 },
  note: { type: "string", maxLength: 500 },
};

exports.handler = async (event) => {
  try {
    const requesterId = event.requestContext?.authorizer?.claims?.sub;
    if (!requesterId) return response(401, { error: "Unauthorized" });

    const transactionId = event.pathParameters?.transactionId;
    if (!transactionId) return response(400, { error: "transactionId is required" });

    const { allowed } = await checkRateLimit(`putSession#${requesterId}`, 20, 60);
    if (!allowed) {
      return response(429, { error: "too many requests, slow down a bit" });
    }

    const txResult = await client.send(
      new GetCommand({ TableName: TRANSACTIONS_TABLE, Key: { transactionId } })
    );
    if (!txResult.Item) return response(404, { error: "Booking not found" });

    // only the teacher on this exact booking may set its session details
    if (txResult.Item.counterpartyId !== requesterId) {
      return response(403, { error: "Only the teacher can set session details" });
    }

    const body = sanitize(JSON.parse(event.body || "{}"));
    const { valid, errors } = validate(body, schema);
    if (!valid) {
      return response(400, { error: "validation failed", details: errors });
    }
    if (!["online", "in-person"].includes(body.format)) {
      return response(400, { error: "format must be 'online' or 'in-person'" });
    }

    const now = new Date().toISOString();
    const session = {
      transactionId,
      teacherId: requesterId,
      learnerId: txResult.Item.userId,
      skillId: txResult.Item.skillId,
      format: body.format,
      sessionLink: body.sessionLink || null,
      location: body.location || null,
      suggestedDateTime: body.suggestedDateTime || null,
      note: body.note || null,
      updatedAt: now,
    };

    await client.send(
      new PutCommand({
        TableName: SESSIONS_TABLE,
        Item: { ...session, createdAt: now },
      })
    );

    return response(200, { message: "Session details saved", session });
  } catch (err) {
    console.error(err);
    return response(500, { error: "Internal server error" });
  }
};
</file>

<file path="backend/src/handlers/transferCredits.js">
const { DynamoDBClient } = require("@aws-sdk/client-dynamodb");
const {
  DynamoDBDocumentClient,
  TransactWriteCommand,
} = require("@aws-sdk/lib-dynamodb");
const { randomUUID } = require("crypto");
const { validate, sanitize } = require("../lib/validate");
const { checkRateLimit } = require("../lib/rateLimit");

const client = DynamoDBDocumentClient.from(new DynamoDBClient({}));
const USERS_TABLE = process.env.USERS_TABLE;
const TRANSACTIONS_TABLE = process.env.TRANSACTIONS_TABLE;
const TEACHER_CUT = Number(process.env.TEACHER_CUT || 8);
const PLATFORM_USER_ID = "PLATFORM";

const response = (statusCode, body) => ({
  statusCode,
  headers: {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": process.env.ALLOWED_ORIGIN || "*",
  },
  body: JSON.stringify(body),
});

const schema = {
  teacherId: { type: "string", required: true, minLength: 1, maxLength: 100 },
  amount: { type: "number", required: true, min: 1, max: 1000 },
  skillId: { type: "string", maxLength: 100 },
};

exports.handler = async (event) => {
  try {
    const learnerId = event.requestContext?.authorizer?.claims?.sub;
    if (!learnerId) return response(401, { error: "Unauthorized" });

    const { allowed } = await checkRateLimit(`transfer#${learnerId}`, 5, 60);
    if (!allowed) {
      return response(429, { error: "too many transfers, try again in a minute" });
    }

    const body = sanitize(JSON.parse(event.body || "{}"));
    const { valid, errors } = validate(body, schema);
    if (!valid) {
      return response(400, { error: "validation failed", details: errors });
    }

    const { teacherId, amount, skillId } = body;

    if (learnerId === teacherId) {
      return response(400, { error: "Cannot transfer credits to yourself" });
    }

    const teacherShare = Math.min(amount, TEACHER_CUT);
    const platformShare = amount - teacherShare;

    const transactionId = randomUUID();
    const timestamp = new Date().toISOString();

    await client.send(
      new TransactWriteCommand({
        TransactItems: [
          {
            Update: {
              TableName: USERS_TABLE,
              Key: { userId: learnerId },
              UpdateExpression: "SET creditBalance = creditBalance - :amt",
              ConditionExpression: "creditBalance >= :amt",
              ExpressionAttributeValues: { ":amt": amount },
            },
          },
          {
            Update: {
              TableName: USERS_TABLE,
              Key: { userId: teacherId },
              UpdateExpression: "SET creditBalance = creditBalance + :share",
              ExpressionAttributeValues: { ":share": teacherShare },
            },
          },
          {
            Update: {
              TableName: USERS_TABLE,
              Key: { userId: PLATFORM_USER_ID },
              UpdateExpression:
                "SET creditBalance = if_not_exists(creditBalance, :zero) + :share",
              ExpressionAttributeValues: { ":share": platformShare, ":zero": 0 },
            },
          },
          {
            Put: {
              TableName: TRANSACTIONS_TABLE,
              Item: {
                transactionId,
                userId: learnerId,
                counterpartyId: teacherId,
                skillId: skillId || null,
                amount,
                teacherShare,
                platformShare,
                type: "SPEND",
                createdAt: timestamp,
              },
            },
          },
        ],
      })
    );

    return response(200, {
      message: "Credits transferred",
      transactionId,
      learnerId,
      teacherId,
      amountPaid: amount,
      teacherReceived: teacherShare,
      platformFee: platformShare,
    });
  } catch (err) {
    if (err.name === "TransactionCanceledException") {
      return response(400, { error: "Insufficient credit balance" });
    }
    console.error(err);
    return response(500, { error: "Internal server error" });
  }
};
</file>

<file path="backend/src/lib/rateLimit.js">
const { DynamoDBClient } = require("@aws-sdk/client-dynamodb");
const { DynamoDBDocumentClient, UpdateCommand } = require("@aws-sdk/lib-dynamodb");

const client = DynamoDBDocumentClient.from(new DynamoDBClient({}));
const TABLE = process.env.RATE_LIMITS_TABLE;

// fixed-window limiter: "key" gets `limit` requests per `windowSeconds`, then blocks
async function checkRateLimit(key, limit, windowSeconds) {
  const now = Math.floor(Date.now() / 1000);
  const windowStart = now - (now % windowSeconds);
  const rateLimitKey = `${key}#${windowStart}`;
  const expiresAt = windowStart + windowSeconds * 2;

  try {
    const result = await client.send(
      new UpdateCommand({
        TableName: TABLE,
        Key: { rateLimitKey },
        UpdateExpression: "SET requestCount = if_not_exists(requestCount, :zero) + :one, expiresAt = :ttl",
        ConditionExpression: "attribute_not_exists(requestCount) OR requestCount < :limit",
        ExpressionAttributeValues: { ":zero": 0, ":one": 1, ":limit": limit, ":ttl": expiresAt },
        ReturnValues: "UPDATED_NEW",
      })
    );
    return { allowed: true, remaining: limit - result.Attributes.requestCount };
  } catch (err) {
    if (err.name === "ConditionalCheckFailedException") {
      return { allowed: false, remaining: 0 };
    }
    throw err;
  }
}

module.exports = { checkRateLimit };
</file>

<file path="backend/src/lib/validate.js">
function validate(body, schema) {
  const errors = [];
  const input = body || {};
  const allowedFields = Object.keys(schema);

  for (const field of Object.keys(input)) {
    if (!allowedFields.includes(field)) {
      errors.push(`unexpected field: ${field}`);
    }
  }

  for (const [field, rules] of Object.entries(schema)) {
    const value = input[field];

    if (value === undefined || value === null || value === "") {
      if (rules.required) errors.push(`${field} is required`);
      continue;
    }

    if (rules.type === "string" && typeof value !== "string") {
      errors.push(`${field} must be a string`);
      continue;
    }
    if (rules.type === "number" && typeof value !== "number") {
      errors.push(`${field} must be a number`);
      continue;
    }

    if (rules.type === "string") {
      if (rules.maxLength && value.length > rules.maxLength) {
        errors.push(`${field} is too long (max ${rules.maxLength} characters)`);
      }
      if (rules.minLength && value.length < rules.minLength) {
        errors.push(`${field} is too short (min ${rules.minLength} characters)`);
      }
      if (rules.pattern && !rules.pattern.test(value)) {
        errors.push(`${field} has an invalid format`);
      }
    }

    if (rules.type === "number") {
      if (rules.min !== undefined && value < rules.min) {
        errors.push(`${field} must be at least ${rules.min}`);
      }
      if (rules.max !== undefined && value > rules.max) {
        errors.push(`${field} must be at most ${rules.max}`);
      }
    }
  }

  return { valid: errors.length === 0, errors };
}

// trims whitespace and strips control characters from every string field
function sanitize(body) {
  const clean = {};
  for (const [key, value] of Object.entries(body || {})) {
    clean[key] = typeof value === "string" ? value.trim().replace(/[\x00-\x1F\x7F]/g, "") : value;
  }
  return clean;
}

const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

module.exports = { validate, sanitize, EMAIL_PATTERN };
</file>

<file path="backend/template.yaml">
AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: >
  SkillSwap - Peer Skill Exchange Platform
  Core MVP backend: Cognito auth, DynamoDB storage, Lambda functions, API Gateway

Globals:
  Function:
    Runtime: nodejs20.x
    Timeout: 10
    MemorySize: 256
    Environment:
      Variables:
        USERS_TABLE: !Ref UsersTable
        ALLOWED_ORIGIN: !Ref AllowedOrigin
        SKILLS_TABLE: !Ref SkillsTable
        TRANSACTIONS_TABLE: !Ref TransactionsTable
        RATE_LIMITS_TABLE: !Ref RateLimitsTable
        SESSIONS_TABLE: !Ref SessionsTable
        CERTIFICATES_TABLE: !Ref CertificatesTable
        STARTING_CREDITS: "20"
        TEACHER_CUT: "8"

Parameters:
  Stage:
    Type: String
    Default: dev
    AllowedValues: [dev, prod]
  AllowedOrigin:
    Type: String
    Default: "http://localhost:3000"
    Description: The frontend origin allowed to call this API (React dev server by default)

Resources:

  SkillSwapUserPool:
    Type: AWS::Cognito::UserPool
    Properties:
      UserPoolName: !Sub skillswap-users-${Stage}
      AutoVerifiedAttributes: [email]
      UsernameAttributes: [email]
      Policies:
        PasswordPolicy:
          MinimumLength: 8
          RequireLowercase: true
          RequireNumbers: true
          RequireSymbols: false
          RequireUppercase: false
      Schema:
        - Name: email
          Required: true
          Mutable: true

  SkillSwapUserPoolClient:
    Type: AWS::Cognito::UserPoolClient
    Properties:
      ClientName: !Sub skillswap-client-${Stage}
      UserPoolId: !Ref SkillSwapUserPool
      ExplicitAuthFlows:
        - ALLOW_USER_PASSWORD_AUTH
        - ALLOW_REFRESH_TOKEN_AUTH
      GenerateSecret: false

  # One item per user: profile + live credit balance
  UsersTable:
    Type: AWS::Serverless::SimpleTable
    Properties:
      TableName: !Sub SkillSwap-Users-${Stage}
      PrimaryKey:
        Name: userId
        Type: String

  # One item per skill listing a user offers to teach
  SkillsTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub SkillSwap-Skills-${Stage}
      AttributeDefinitions:
        - AttributeName: skillId
          AttributeType: S
        - AttributeName: teacherId
          AttributeType: S
      KeySchema:
        - AttributeName: skillId
          KeyType: HASH
      GlobalSecondaryIndexes:
        - IndexName: byTeacher
          KeySchema:
            - AttributeName: teacherId
              KeyType: HASH
          Projection:
            ProjectionType: ALL
      BillingMode: PAY_PER_REQUEST

  # Ledger of every credit movement (earn from teaching, spend on learning)
  TransactionsTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub SkillSwap-Transactions-${Stage}
      AttributeDefinitions:
        - AttributeName: transactionId
          AttributeType: S
        - AttributeName: userId
          AttributeType: S
        - AttributeName: counterpartyId
          AttributeType: S
      KeySchema:
        - AttributeName: transactionId
          KeyType: HASH
      GlobalSecondaryIndexes:
        - IndexName: byUser
          KeySchema:
            - AttributeName: userId
              KeyType: HASH
          Projection:
            ProjectionType: ALL
        - IndexName: byCounterparty
          KeySchema:
            - AttributeName: counterpartyId
              KeyType: HASH
          Projection:
            ProjectionType: ALL
      BillingMode: PAY_PER_REQUEST

  # Fixed-window counters backing the per-user / per-IP rate limiter.
  # Items expire on their own via TTL, so this table never needs cleanup.
  RateLimitsTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub SkillSwap-RateLimits-${Stage}
      AttributeDefinitions:
        - AttributeName: rateLimitKey
          AttributeType: S
      KeySchema:
        - AttributeName: rateLimitKey
          KeyType: HASH
      TimeToLiveSpecification:
        AttributeName: expiresAt
        Enabled: true
      BillingMode: PAY_PER_REQUEST

  # Session logistics (link, location, suggested time, note) set by the
  # teacher after a booking - keyed by transactionId, one-to-one with a booking
  SessionsTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub SkillSwap-Sessions-${Stage}
      AttributeDefinitions:
        - AttributeName: transactionId
          AttributeType: S
      KeySchema:
        - AttributeName: transactionId
          KeyType: HASH
      BillingMode: PAY_PER_REQUEST

  # Certificates issued by a teacher declaring a learner has acquired a
  # skill - one per booking, keyed by transactionId, same 1:1 relationship
  # pattern as SessionsTable
  CertificatesTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub SkillSwap-Certificates-${Stage}
      AttributeDefinitions:
        - AttributeName: transactionId
          AttributeType: S
        - AttributeName: learnerId
          AttributeType: S
      KeySchema:
        - AttributeName: transactionId
          KeyType: HASH
      GlobalSecondaryIndexes:
        - IndexName: byLearner
          KeySchema:
            - AttributeName: learnerId
              KeyType: HASH
          Projection:
            ProjectionType: ALL
      BillingMode: PAY_PER_REQUEST

  SkillSwapApi:
    Type: AWS::Serverless::Api
    Properties:
      StageName: !Ref Stage
      Cors:
        AllowMethods: "'GET,POST,PUT,OPTIONS'"
        AllowHeaders: "'Content-Type,Authorization'"
        AllowOrigin: !Sub "'${AllowedOrigin}'"
      MethodSettings:
        - ResourcePath: "/*"
          HttpMethod: "*"
          ThrottlingRateLimit: 20
          ThrottlingBurstLimit: 40
      Auth:
        Authorizers:
          CognitoAuthorizer:
            UserPoolArn: !GetAtt SkillSwapUserPool.Arn

  # Called right after Cognito sign-up confirmation to create the app-side
  # profile record and grant starting credits
  CreateUserFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/createUser.handler
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref UsersTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /users
            Method: post

  # Returns the caller's own profile, identified from their JWT - never
  # takes an id in the path, so there is no way to fetch anyone else's data
  GetUserFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getUser.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref UsersTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /users/me
            Method: get
            Auth:
              Authorizer: CognitoAuthorizer

  PostSkillFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/postSkill.handler
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref SkillsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /skills
            Method: post
            Auth:
              Authorizer: CognitoAuthorizer

  BrowseSkillsFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/browseSkills.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref SkillsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /skills
            Method: get

  MatchSkillsFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/matchSkills.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref SkillsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /match
            Method: post
            Auth:
              Authorizer: CognitoAuthorizer

  TransferCreditsFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/transferCredits.handler
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref UsersTable
        - DynamoDBCrudPolicy:
            TableName: !Ref TransactionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /credits/transfer
            Method: post
            Auth:
              Authorizer: CognitoAuthorizer

  # Returns the caller's own booking history (as the learner) - reads from
  # the byUser GSI, never takes a user id in the path or body
  GetTransactionsFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getTransactions.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TransactionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /transactions/me
            Method: get
            Auth:
              Authorizer: CognitoAuthorizer

  # Mirror of GetTransactionsFunction, but from the teacher's side - returns
  # bookings where the caller is the counterparty (teacher), not the learner
  GetTeachingBookingsFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getTeachingBookings.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TransactionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /transactions/teaching
            Method: get
            Auth:
              Authorizer: CognitoAuthorizer

  # Teacher-only write: sets session logistics for one specific booking,
  # verified against the real transaction record, never trusts the client
  PutSessionFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/putSession.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TransactionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref SessionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /sessions/{transactionId}
            Method: put
            Auth:
              Authorizer: CognitoAuthorizer

  # Read access limited to the two real participants on that booking
  GetSessionFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getSession.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref SessionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /sessions/{transactionId}
            Method: get
            Auth:
              Authorizer: CognitoAuthorizer

  # Teacher-only write: certifies a learner has acquired a skill for one
  # specific booking, same ownership verification pattern as PutSessionFunction
  IssueCertificateFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/issueCertificate.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TransactionsTable
        - DynamoDBCrudPolicy:
            TableName: !Ref CertificatesTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /certificates/{transactionId}
            Method: put
            Auth:
              Authorizer: CognitoAuthorizer

  # Read access limited to the two real participants on that booking
  GetCertificateFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getCertificate.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref CertificatesTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /certificates/{transactionId}
            Method: get
            Auth:
              Authorizer: CognitoAuthorizer

  # Returns the caller's own full certificate list (as the learner) - reads
  # from the byLearner GSI, same pattern as GetTransactionsFunction
  GetCertificatesFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getCertificates.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref CertificatesTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /certificates/me
            Method: get
            Auth:
              Authorizer: CognitoAuthorizer

  GetUserPublicFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: src/handlers/getUserPublic.handler
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref UsersTable
        - DynamoDBCrudPolicy:
            TableName: !Ref RateLimitsTable
      Events:
        Api:
          Type: Api
          Properties:
            RestApiId: !Ref SkillSwapApi
            Path: /users/{userId}/public
            Method: get

  # WAF - blocks abusive IPs before they ever reach API Gateway
  SkillSwapWebAcl:
    Type: AWS::WAFv2::WebACL
    Properties:
      Name: !Sub skillswap-waf-${Stage}
      Scope: REGIONAL
      DefaultAction:
        Allow: {}
      VisibilityConfig:
        SampledRequestsEnabled: true
        CloudWatchMetricsEnabled: true
        MetricName: !Sub skillswap-waf-${Stage}
      Rules:
        - Name: RateLimitPerIp
          Priority: 0
          Action:
            Block: {}
          Statement:
            RateBasedStatement:
              Limit: 300
              AggregateKeyType: IP
          VisibilityConfig:
            SampledRequestsEnabled: true
            CloudWatchMetricsEnabled: true
            MetricName: RateLimitPerIp
        - Name: AWSCommonRuleSet
          Priority: 1
          OverrideAction:
            None: {}
          Statement:
            ManagedRuleGroupStatement:
              VendorName: AWS
              Name: AWSManagedRulesCommonRuleSet
          VisibilityConfig:
            SampledRequestsEnabled: true
            CloudWatchMetricsEnabled: true
            MetricName: AWSCommonRuleSet

  SkillSwapWebAclAssociation:
    Type: AWS::WAFv2::WebACLAssociation
    Properties:
      ResourceArn: !Sub arn:aws:apigateway:${AWS::Region}::/restapis/${SkillSwapApi}/stages/${Stage}
      WebACLArn: !GetAtt SkillSwapWebAcl.Arn

Outputs:
  ApiUrl:
    Description: Base URL for the SkillSwap API
    Value: !Sub https://${SkillSwapApi}.execute-api.${AWS::Region}.amazonaws.com/${Stage}/
  UserPoolId:
    Value: !Ref SkillSwapUserPool
  UserPoolClientId:
    Value: !Ref SkillSwapUserPoolClient
</file>

